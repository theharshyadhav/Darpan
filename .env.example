# Copy to .env.local (local) or paste into Vercel > Settings > Environment Variables (hosted).
# Every value is optional. With nothing set, Darpan runs in Demo Mode: sample numbers made on the
# device, built-in rules instead of an AI model, and nothing sent anywhere.

# ---- YouCam AI (skin analysis and makeup try-on). Required for real measurements.
YOUCAM_API_KEY=
# YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# YOUCAM_SKIN_VERSION=v2.1
# YOUCAM_FACE_STRICTNESS=high        # strict | high | medium | low | flexible
# YOUCAM_TONE=true                   # also read skin tone, to state uncertainty honestly
# YOUCAM_SKIN_ACTIONS=               # comma list to narrow the concerns requested
# YOUCAM_COST_SKIN=12                # estimated units per call (npm run doctor prints the real table)
# YOUCAM_COST_TONE=3
# YOUCAM_COST_LOOK=8

# ---- The mirror's brain. Groq is the free default; xAI Grok is one variable away.
# With no key at all the mirror uses its built-in rules.
GROQ_API_KEY=
# XAI_API_KEY=
# LLM_PROVIDER=groq                  # groq | xai | gemini | openrouter | custom | off
# LLM_MODEL=                         # optional comma list, best first
# LLM_VISION_MODEL=
# LLM_TIMEOUT_MS=12000

# ---- Spending guards (units are YouCam units)
# DARPAN_DAILY_UNITS=240
# DARPAN_IP_DAILY_UNITS=60
# DARPAN_MIN_BALANCE=0
# DARPAN_SCAN_COOLDOWN_SEC=20
# DARPAN_CHAT_PER_MIN=30
# DARPAN_VISION_PER_MIN=6
# DARPAN_MAX_IMAGE_BYTES=6000000
# DARPAN_DEMO_ONLY=false             # true forces Demo Mode even when keys are present

# ---- Optional shared limits across serverless instances (Upstash Redis, free tier)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Extra browser origins allowed to call the API (rarely needed)
# ALLOWED_ORIGINS=

# ---- Local testing against the mock YouCam server (npm run mock:youcam). Never set these in production.
# DARPAN_ALLOW_HTTP_UPSTREAM=1
# YOUCAM_API_KEY=mock-key
# YOUCAM_BASE_URL=http://127.0.0.1:4010
